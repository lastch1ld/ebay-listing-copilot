# Copy to .env for local development. Never put real values in this file.

# Which eBay environment the app talks to: sandbox | production
EBAY_ENVIRONMENT=sandbox

# eBay OAuth application credentials (Sandbox or Production, from developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/ebay/callback

# OpenAI API key used for source-backed research
OPENAI_API_KEY=
# Model used for image + web-search-backed item research (no hard-coded fallback)
OPENAI_MODEL=

# Local SQLite database path
DATABASE_URL=sqlite:///./backend/data/app.db
